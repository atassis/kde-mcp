# kde-mcp policy.toml — load from `~/.config/kde-mcp/policy.toml`.
#
# Schema is a flat per-app table. Tiers and sentinels per spec §6.0:
#
#   tier      = "view_only" | "click_only" | "full"  (default "full")
#   sentinel  = "shell_access" | "filesystem_access" | "system_settings"
#
# Apps not listed here default to tier=full, no sentinel — but still go
# through per-app approval on first destructive call.

# ─── Browsers ──────────────────────────────────────────────────────────────
# View-only: destructive tools rejected (`tier_restricted`). Route browser
# automation through Playwright-MCP instead.
[apps.firefox]
tier = "view_only"

[apps.chromium]
tier = "view_only"

[apps."brave-browser"]
tier = "view_only"

[apps."google-chrome"]
tier = "view_only"

[apps.vivaldi]
tier = "view_only"

[apps."Microsoft-edge"]
tier = "view_only"

# ─── Terminals ─────────────────────────────────────────────────────────────
# click_only: keyboard.type rejected; keyboard.key only for navigation keys
# (Tab/Return/Escape/Page_*/arrows + Ctrl+C/V/X/Z/A). Click+scroll+drag OK.
# sentinel: shell_access (response carries an informational warning).
[apps.konsole]
tier = "click_only"
sentinel = "shell_access"

[apps."com.mitchellh.ghostty"]
tier = "click_only"
sentinel = "shell_access"

[apps.alacritty]
tier = "click_only"
sentinel = "shell_access"

[apps.kitty]
tier = "click_only"
sentinel = "shell_access"

[apps."wezterm-gui"]
tier = "click_only"
sentinel = "shell_access"

[apps.foot]
tier = "click_only"
sentinel = "shell_access"

[apps.tilix]
tier = "click_only"
sentinel = "shell_access"

[apps."gnome-terminal"]
tier = "click_only"
sentinel = "shell_access"

[apps.yakuake]
tier = "click_only"
sentinel = "shell_access"

# ─── IDEs / editors with command palettes ──────────────────────────────────
# Same reasoning as terminals: typing into a Ctrl+P / Ctrl+Shift+P command
# palette can execute arbitrary actions. Route deliberate file edits through
# `text_editor.edit` instead.
[apps."code-oss"]
tier = "click_only"

[apps.code]
tier = "click_only"

[apps."jetbrains-idea"]
tier = "click_only"

[apps."jetbrains-pycharm"]
tier = "click_only"

[apps.kate]
tier = "click_only"

# ─── File managers ─────────────────────────────────────────────────────────
[apps.dolphin]
tier = "full"
sentinel = "filesystem_access"

[apps.nautilus]
tier = "full"
sentinel = "filesystem_access"

# ─── System settings ───────────────────────────────────────────────────────
[apps.systemsettings]
tier = "full"
sentinel = "system_settings"

[apps."gnome-control-center"]
tier = "full"
sentinel = "system_settings"

# ─── Password managers ─────────────────────────────────────────────────────
[apps."org.keepassxc.KeePassXC"]
tier = "full"
sentinel = "filesystem_access"

[apps.Bitwarden]
tier = "full"
sentinel = "filesystem_access"
