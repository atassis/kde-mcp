[Unit]
Description=kde-mcp daemon Unix socket (ADR-0012)
PartOf=kde-mcp.service

[Socket]
# %t expands to $XDG_RUNTIME_DIR (typically /run/user/<uid>) for user units.
ListenStream=%t/kde-mcp/mcp.sock
# Only the owning UID can open the socket.
SocketMode=0600
# Single accept loop in the daemon — each request runs on its own
# tokio task inside the process.
Accept=false

[Install]
WantedBy=sockets.target
