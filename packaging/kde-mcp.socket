[Unit]
Description=kde-mcp daemon socket (ADR-0012)
PartOf=kde-mcp.service

[Socket]
ListenStream=127.0.0.1:7575
NoDelay=true
# Single accept loop in the daemon. Each request is dispatched on its own
# tokio task inside the process; we never want systemd to fork-per-connection.
Accept=false

[Install]
WantedBy=sockets.target
